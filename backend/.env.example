NODE_ENV=development
PORT=3000
JWT_SECRET=study-system-dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# sqlite (default, no Docker needed) | postgres
DB_TYPE=sqlite
DB_DATABASE=study_system.sqlite

# PostgreSQL (when DB_TYPE=postgres and Docker is running)
DB_HOST=localhost
DB_PORT=5432
DB_USER=study
DB_PASSWORD=study_secret
DB_NAME=study_system
